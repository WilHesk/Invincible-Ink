---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Pledge">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <p class="text-sm font-semibold text-indigo-600 tracking-wide uppercase eyebrow mb-4">The pledge</p>
    <h1 class="text-5xl font-extrabold tracking-tight text-slate-900 sm:text-6xl mb-12">
      I solemnly swear&hellip;
    </h1>
    
    <div class="space-y-8 text-2xl text-slate-700 leading-relaxed font-serif">
      <p class="block italic">
        "That everything I write for you shall be utterly, unmistakeably and unwaveringly human. For better or worse."
      </p>
      
      <p class="block text-xl">
        I may use AI for the stuff around the edges. The data, the analysis. Like running textual analysis on your competitors or isolating the keywords you need to rank for.
      </p>
      
      <p class="block final font-bold text-slate-900 text-3xl mt-12">
        But everything I write for you will be 100% me. Otherwise, why not just use a robot, right?
      </p>
    </div>
  </div>
</Layout>
