---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: "Narrative development",
    desc: "Your brand needs to look and feel the same at every touchpoint — wherever it shows up, whoever's doing the talking. I will help you achieve this with tailored brand guidelines and tone of voice frameworks.",
    color: "bg-indigo-50",
    border: "border-indigo-100"
  },
  {
    title: "Ads (print, digital, OOH)",
    desc: "At LIV Golf I have written ads for city-wide takeovers in the world's most electric cities. Now I can channel this same creativity into your cause.",
    color: "bg-blue-50",
    border: "border-blue-100"
  },
  {
    title: "SEO, AEO and GEO",
    desc: "The advent of AI summaries has changed the rules of SEO. I work with this new reality every day and can give you content that's ahead of the latest trends.",
    color: "bg-emerald-50",
    border: "border-emerald-100"
  },
  {
    title: "Thought-leadership",
    desc: "As a former journalist and newspaper editor, I will help you cement your thought leadership with persuasive long-form content, including whitepapers, op-eds and detailed guides.",
    color: "bg-violet-50",
    border: "border-violet-100"
  },
  {
    title: "Content Marketing",
    desc: "99% of content marketing looks like... well, marketing. I will put you in the other 1% with content that solves real problems and adds genuine value to your customers' lives.",
    color: "bg-rose-50",
    border: "border-rose-100"
  },
  {
    title: "Script development",
    desc: "Having written for everything from hit podcast series to national radio channels, I can provide tailored scripts for all your audio and video platforms.",
    color: "bg-amber-50",
    border: "border-amber-100"
  }
];
---

<Layout title="Services">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16">
    <div class="max-w-3xl mb-16">
      <p class="text-sm font-semibold text-indigo-600 tracking-wide uppercase eyebrow mb-2">What I do</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-6">
        Copy that converts. Content that inspires.
      </h1>
      <p class="text-xl text-slate-600 mb-6">
        With more than 15 years as a journalist, copywriter and content strategist under my belt, I am uniquely equipped to fulfil your creative requirements.
      </p>
      <p class="text-lg text-slate-600">
        Whether you want short-form copy for your specific audience or long-form content that builds your global credibility, I will provide a precision solution.
      </p>
    </div>

    <!-- Mobile Carousel / Desktop Parallax Container -->
    <div class="relative w-full">
      <div class="flex lg:block overflow-x-auto lg:overflow-visible snap-x snap-mandatory hide-scrollbar gap-6 pb-8 lg:pb-0 lg:space-y-[40vh]">
        {services.map((service, index) => (
          <div class={`flex-none w-[85vw] sm:w-[60vw] lg:w-full snap-center lg:sticky lg:top-32 transition-all duration-500`}>
            <div class={`h-[400px] lg:h-[60vh] rounded-3xl p-8 lg:p-16 border ${service.border} ${service.color} flex flex-col justify-center shadow-lg shadow-slate-200/50`}>
              <div class="text-indigo-600 font-black text-6xl lg:text-8xl opacity-10 mb-4 lg:mb-8 absolute top-8 right-8 lg:top-12 lg:right-12">
                0{index + 1}
              </div>
              <h3 class="text-2xl lg:text-5xl font-bold text-slate-900 mb-4 lg:mb-8 relative z-10 w-3/4">
                {service.title}
              </h3>
              <p class="text-lg lg:text-2xl text-slate-700 leading-relaxed relative z-10 lg:w-2/3 font-light">
                {service.desc}
              </p>
            </div>
          </div>
        ))}
        <!-- Spacer for the last card to scroll up fully -->
        <div class="hidden lg:block h-[10vh]"></div>
      </div>
    </div>
    
    <div class="mt-24 lg:mt-32 bg-slate-900 text-white rounded-3xl p-10 lg:p-16 text-center shadow-2xl relative overflow-hidden">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-indigo-500 via-slate-900 to-slate-900"></div>
      <div class="relative z-10">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Not sure which service fits your brief?</h2>
        <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto font-light">Tell me what you're trying to achieve on a free discovery call, and I'll recommend the right mix — no obligation, no jargon.</p>
        <a href="https://calendly.com/garethbcn/30min?month=2026-09" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 border border-transparent rounded-full shadow-lg shadow-indigo-500/30 text-lg font-bold text-slate-900 bg-white hover:bg-slate-100 transition-all hover:scale-105">
          Book a Call
        </a>
      </div>
    </div>
  </div>
</Layout>
